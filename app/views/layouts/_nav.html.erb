<header class="border-b border-line bg-card/80 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
    <%= link_to root_path, class: "flex items-center gap-2 text-ink no-underline" do %>
      <svg class="rail-mark text-rail" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 17h16M7 4v16M17 4v16M9 12h6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
      </svg>
      <span class="font-serif text-xl tracking-tight">SocialRails</span>
    <% end %>

    <% if user_signed_in? %>
      <nav class="flex items-center gap-1 text-sm">
        <%= link_to "Square", root_path, class: "rounded-md px-3 py-1.5 text-muted hover:bg-paper hover:text-ink" %>
        <%= link_to "People", users_path, class: "rounded-md px-3 py-1.5 text-muted hover:bg-paper hover:text-ink" %>
        <%= link_to "Messages", conversations_path, class: "rounded-md px-3 py-1.5 text-muted hover:bg-paper hover:text-ink" %>
        <%= link_to "Yard", yard_path, class: "rounded-md px-3 py-1.5 text-muted hover:bg-paper hover:text-ink" %>
      </nav>
      <div class="flex items-center gap-3">
        <%= link_to user_path(current_user), class: "flex items-center gap-2 text-sm text-ink no-underline" do %>
          <%= avatar_tag current_user, size: :sm %>
          <span class="hidden sm:inline"><%= current_user.username %></span>
        <% end %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "text-sm text-muted hover:text-rail", form: { data: { turbo: false } } %>
      </div>
    <% else %>
      <div class="flex items-center gap-3 text-sm">
        <%= link_to "Sign in", new_user_session_path, class: "text-muted hover:text-ink" %>
        <%= link_to "Join", new_user_registration_path, class: "rounded-md bg-rail px-3 py-1.5 font-medium text-paper hover:bg-rail-dark" %>
      </div>
    <% end %>
  </div>
</header>
