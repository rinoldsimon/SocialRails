<%= form_with model: chat_message, url: chat_messages_path, id: "yard-form", class: "flex gap-2" do |f| %>
  <%= f.text_area :body, rows: 2, required: true, placeholder: "Say something in the Yard…", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
  <%= f.submit "Send", class: "self-end rounded-md bg-rail px-4 py-2 text-sm text-paper hover:bg-rail-dark" %>
<% end %>
