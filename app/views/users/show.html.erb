<% page_title @user.name %>

<section class="rounded-lg border border-line bg-card p-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="flex gap-4">
      <%= avatar_tag @user, size: :lg %>
      <div>
        <h1 class="font-serif text-3xl text-ink"><%= @user.name %></h1>
        <p class="text-muted">@<%= @user.username %></p>
        <% if @user.bio.present? %>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink"><%= @user.bio %></p>
        <% end %>
        <p class="mt-3 text-sm text-muted">
          <%= pluralize(@user.following.count, "following") %> · <%= pluralize(@user.followers.count, "follower") %>
          <% if github_url(@user) %>
            · <%= link_to "GitHub", github_url(@user), class: "text-rail hover:underline", target: "_blank", rel: "noreferrer" %>
          <% end %>
        </p>
      </div>
    </div>
    <div class="flex gap-2">
      <% if user_signed_in? && @user != current_user %>
        <% follow = current_user.active_follows.find_by(followed_id: @user.id) %>
        <% if follow %>
          <%= button_to "Following", follow_path(follow), method: :delete, class: "rounded-md border border-line px-3 py-1.5 text-sm" %>
        <% else %>
          <%= button_to "Follow", user_follow_path(@user), class: "rounded-md bg-ink px-3 py-1.5 text-sm text-paper" %>
        <% end %>
        <%= button_to "Message", conversations_path(username: @user.username), class: "rounded-md border border-line px-3 py-1.5 text-sm" %>
      <% elsif user_signed_in? %>
        <%= link_to "Edit profile", edit_user_registration_path, class: "rounded-md border border-line px-3 py-1.5 text-sm" %>
      <% end %>
    </div>
  </div>
</section>

<div class="mt-8">
  <h2 class="font-serif text-xl text-ink">Posts</h2>
  <div class="mt-2">
    <%= render @posts %>
    <% if @posts.empty? %>
      <p class="mt-4 text-sm text-muted">No posts yet.</p>
    <% end %>
  </div>
</div>
