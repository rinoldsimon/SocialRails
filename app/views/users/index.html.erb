<% page_title "People" %>

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="font-serif text-3xl text-ink">People</h1>
    <p class="mt-1 text-sm text-muted">Find builders by name or username.</p>
  </div>
  <%= form_with url: users_path, method: :get, class: "flex gap-2" do %>
    <%= text_field_tag :q, @query, placeholder: "Search", class: "rounded-md border border-line bg-card px-3 py-1.5 text-sm outline-none focus:border-rail" %>
    <%= submit_tag "Search", class: "rounded-md border border-line px-3 py-1.5 text-sm" %>
  <% end %>
</div>

<ul class="divide-y divide-line rounded-lg border border-line bg-card">
  <% @users.each do |user| %>
    <li class="px-4 py-3"><%= render "users/card", user: user %></li>
  <% end %>
</ul>
