<% page_title "Edit profile" %>

<div class="mx-auto max-w-md">
  <h1 class="font-serif text-3xl text-ink">Edit profile</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "mt-6 space-y-3" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.text_field :name, placeholder: "Name", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.text_field :username, placeholder: "username", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.email_field :email, autocomplete: "email", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.text_area :bio, placeholder: "Bio", rows: 3, class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.text_field :github_username, placeholder: "GitHub username", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.password_field :password, autocomplete: "new-password", placeholder: "New password (leave blank to keep)", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm new password", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "Current password (required to save)", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.submit "Save", class: "w-full rounded-md bg-rail py-2 text-sm font-medium text-paper hover:bg-rail-dark" %>
  <% end %>
</div>
