<% page_title "Join" %>

<div class="mx-auto max-w-md">
  <h1 class="font-serif text-3xl text-ink">Join the square</h1>
  <p class="mt-2 text-sm text-muted">Pick a username. That’s your public address — not your email.</p>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "mt-6 space-y-3" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.text_field :name, autofocus: true, placeholder: "Name", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.text_field :username, placeholder: "username", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.email_field :email, autocomplete: "email", placeholder: "Email", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.password_field :password, autocomplete: "new-password", placeholder: "Password (#{@minimum_password_length}+ characters)", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm password", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.submit "Create account", class: "w-full rounded-md bg-rail py-2 text-sm font-medium text-paper hover:bg-rail-dark" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
