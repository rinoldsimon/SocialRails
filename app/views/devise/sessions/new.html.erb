<% page_title "Sign in" %>

<div class="mx-auto max-w-md">
  <h1 class="font-serif text-3xl text-ink">Sign in</h1>
  <p class="mt-2 text-sm text-muted">Email, Google, or GitHub. Password reset needs a sending domain in production.</p>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-3" }) do |f| %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.password_field :password, autocomplete: "current-password", placeholder: "Password", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2 text-sm text-muted">
        <%= f.check_box :remember_me %>
        Remember me
      </label>
    <% end %>
    <%= f.submit "Sign in", class: "w-full rounded-md bg-rail py-2 text-sm font-medium text-paper hover:bg-rail-dark" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
