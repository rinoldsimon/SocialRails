<% page_title "New password" %>

<div class="mx-auto max-w-md">
  <h1 class="font-serif text-3xl text-ink">Choose a new password</h1>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "mt-6 space-y-3" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>
    <%= f.password_field :password, autocomplete: "new-password", placeholder: "New password", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm password", class: "w-full rounded-md border border-line bg-card px-3 py-2 text-sm outline-none focus:border-rail" %>
    <%= f.submit "Change password", class: "w-full rounded-md bg-rail py-2 text-sm font-medium text-paper hover:bg-rail-dark" %>
  <% end %>
</div>
