<%- if controller_name != "sessions" %>
  <p class="mt-4 text-sm"><%= link_to "Sign in", new_session_path(resource_name), class: "text-rail hover:underline" %></p>
<% end %>

<%- if devise_mapping.registerable? && controller_name != "registrations" %>
  <p class="mt-2 text-sm"><%= link_to "Create an account", new_registration_path(resource_name), class: "text-rail hover:underline" %></p>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
  <p class="mt-2 text-sm"><%= link_to "Forgot password?", new_password_path(resource_name), class: "text-muted hover:text-ink" %></p>
<% end %>

<%- if devise_mapping.omniauthable? && Devise.omniauth_configs.any? %>
  <div class="mt-6 space-y-2 border-t border-line pt-4">
    <%- Devise.omniauth_configs.keys.each do |provider| %>
      <%= button_to "Continue with #{provider.to_s.include?("google") ? "Google" : "GitHub"}",
            omniauth_authorize_path(resource_name, provider),
            method: :post,
            data: { turbo: false },
            class: "w-full rounded-md border border-line bg-card py-2 text-sm hover:border-rail" %>
    <% end %>
  </div>
<% end %>
