<div id="<%= dom_id(comment) %>" class="flex gap-2 text-sm">
  <%= link_to user_path(comment.user) do %><%= avatar_tag comment.user, size: :sm %><% end %>
  <div class="min-w-0 flex-1 rounded-md bg-paper px-3 py-2">
    <p>
      <%= link_to comment.user.name, user_path(comment.user), class: "font-medium text-ink hover:text-rail" %>
      <span class="text-muted"> · <%= formatted_time(comment.created_at) %></span>
    </p>
    <p class="mt-1 whitespace-pre-wrap text-ink"><%= comment.body %></p>
    <% if user_signed_in? && policy(comment).destroy? %>
      <%= button_to "Remove", post_comment_path(comment.post, comment), method: :delete, class: "mt-1 text-xs text-muted hover:text-rail" %>
    <% end %>
  </div>
</div>
