<% page_title "Meet on the rails" %>

<section class="mx-auto max-w-2xl py-6 text-center">
  <p class="text-sm uppercase tracking-[0.2em] text-rail">Town square · Rails 8</p>
  <h1 class="mt-3 font-serif text-4xl leading-tight text-ink sm:text-5xl">Meet on the rails.</h1>
  <p class="mt-4 text-base leading-relaxed text-muted">SocialRails is a small, chronological social network for builders. No algorithm. No ads. Newest first, always.</p>
  <div class="mt-6 flex justify-center gap-3">
    <%= link_to "Join the square", new_user_registration_path, class: "rounded-md bg-rail px-4 py-2 text-sm font-medium text-paper hover:bg-rail-dark" %>
    <%= link_to "Sign in", new_user_session_path, class: "rounded-md border border-line px-4 py-2 text-sm text-ink hover:border-rail" %>
  </div>
  <p class="mt-4 text-xs text-muted">Demo people are already here. Sign in as <span class="font-medium text-ink">maya@socialrails.dev</span> / <span class="font-medium text-ink">demo1234</span>.</p>
</section>

<%= render "home/demo" %>

<% if @preview_posts.any? %>
  <section class="mx-auto mt-4 max-w-2xl">
    <h2 class="font-serif text-xl text-ink">Live on the square</h2>
    <div class="mt-2 border-t border-line">
      <%= render @preview_posts %>
    </div>
  </section>
<% end %>
