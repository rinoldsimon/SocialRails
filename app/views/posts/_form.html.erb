<%= form_with model: post, id: "composer", class: "rounded-lg border border-line bg-card p-4" do |f| %>
  <label class="font-serif text-lg text-ink">What’s on the rails?</label>
  <p class="mt-1 text-xs text-muted">Newest first. No ranking. No ads.</p>
  <%= f.text_area :body, rows: 3, maxlength: 500, required: true, placeholder: "A thought, a ship, a question…", class: "mt-3 w-full resize-y rounded-md border border-line bg-paper px-3 py-2 text-sm outline-none focus:border-rail", data: { controller: "composer", action: "input->composer#count" } %>
  <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
    <%= f.url_field :link_url, placeholder: "Optional repo or link (https://…)", class: "min-w-[12rem] flex-1 rounded-md border border-line bg-paper px-3 py-1.5 text-sm outline-none focus:border-rail" %>
    <%= f.submit "Post", class: "rounded-md bg-rail px-4 py-1.5 text-sm font-medium text-paper hover:bg-rail-dark" %>
  </div>
<% end %>
