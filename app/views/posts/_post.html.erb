<article id="<%= dom_id(post) %>" class="border-b border-line py-5">
  <div class="flex gap-3">
    <%= link_to user_path(post.user) do %><%= avatar_tag post.user %><% end %>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-baseline gap-x-2 text-sm">
        <%= link_to post.user.name, user_path(post.user), class: "font-medium text-ink hover:text-rail" %>
        <span class="text-muted">@<%= post.user.username %></span>
        <span class="text-muted">· <%= formatted_time(post.created_at) %></span>
      </div>
      <p class="mt-2 whitespace-pre-wrap text-[15px] leading-relaxed text-ink"><%= post.body %></p>
      <% if post.link_url.present? %>
        <p class="prose-post mt-2 truncate text-sm">
          <%= link_to post.link_url, post.link_url, target: "_blank", rel: "noreferrer" %>
        </p>
      <% end %>
      <div class="mt-3 flex items-center gap-4 text-sm text-muted">
        <div id="<%= dom_id(post, :like) %>">
          <%= render "likes/button", likeable: post %>
        </div>
        <span><%= pluralize(post.comments.size, "comment") %></span>
        <% if user_signed_in? && policy(post).destroy? %>
          <%= button_to "Remove", post_path(post), method: :delete, class: "hover:text-rail", form: { data: { turbo_confirm: "Remove this post?" } } %>
        <% end %>
      </div>

      <% if user_signed_in? %>
        <div id="<%= dom_id(post, :comments) %>" class="mt-4 space-y-3">
          <%= render post.comments.sort_by(&:created_at) %>
        </div>
        <%= form_with model: [post, Comment.new], class: "mt-3 flex gap-2" do |f| %>
          <%= f.text_field :body, placeholder: "Reply…", maxlength: 280, class: "w-full rounded-md border border-line bg-paper px-3 py-1.5 text-sm outline-none focus:border-rail" %>
          <%= f.submit "Reply", class: "rounded-md border border-line px-3 py-1.5 text-sm text-muted hover:text-ink" %>
        <% end %>
      <% end %>
    </div>
  </div>
</article>
